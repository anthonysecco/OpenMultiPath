#!/bin/bash
# omp-lab: run both daemons on this box in two network namespaces joined by
# two shaped links, and put real traffic through them.
#
# It exists so the bulk cascade, the resequencer and classification can be
# exercised end to end - wire negotiation, TUN, classifier, scheduler, path
# sockets, far-end reordering - with no vehicle and no WAN data spent. What it
# cannot do is reproduce a real carrier; netem's delay and rate limit are a
# caricature of one. See v0.2-design.md, section 10.
#
#   omp-lab up [ompd-binary]      build the namespaces and start both daemons
#   omp-lab down                  tear everything down
#   omp-lab mode cascade|flow     switch bulk_scheduler on both ends (hot reload)
#   omp-lab shape <path> <upload-args> <download-args>
#                                 re-shape one link, e.g. shape 1 "delay 45ms rate 20mbit" "delay 45ms rate 40mbit"
#   omp-lab iperf [args]          single-flow TCP from the vehicle side to home, JSON summary
#   omp-lab rtp <seconds> <pcap> [up|down]
#                                 send Opus audio and VP8 video as RTP, from the vehicle side
#                                 (up, the default) or from home (down), capturing what arrives
#                                 at the other end into <pcap>; judge it with rtp-report
#   omp-lab state rv|home         print the daemon's state file
#
# Topology:
#
#   omp-lab-rv                               omp-lab-home
#   omp0 10.30.0.2 (TUN, ompd initiator)     omp0 10.30.0.1 (TUN, ompd responder)
#   rv-p0 10.20.1.2  ==== veth, netem ====   home-p0 \
#   rv-p1 10.20.1.3  ==== veth, netem ====   home-p1  br0 10.20.1.1
#
# Path 0 is the fast link and path 1 the slow one by default: 15 ms and 45 ms
# each way, 20 Mbit up and 40 Mbit down on both.

set -euo pipefail

RV=omp-lab-rv
HOME_NS=omp-lab-home
DIR=${OMP_LAB_DIR:-/tmp/omp-lab}
PORT=51830

inrv()   { ip netns exec "$RV" "$@"; }
inhome() { ip netns exec "$HOME_NS" "$@"; }

shape() {
	local p=$1 up=$2 down=$3
	inrv   tc qdisc replace dev "rv-p$p"   root netem $up   limit 2000
	inhome tc qdisc replace dev "home-p$p" root netem $down limit 2000
}

up() {
	local bin=${1:-$(dirname "$0")/../../bin/ompd}
	[ -x "$bin" ] || { echo "no ompd binary at $bin; build one first" >&2; exit 1; }
	down >/dev/null 2>&1 || true
	mkdir -p "$DIR/rv" "$DIR/home"

	ip netns add "$RV"
	ip netns add "$HOME_NS"
	inrv ip link set lo up
	inhome ip link set lo up

	inhome ip link add br0 type bridge
	inhome ip addr add 10.20.1.1/24 dev br0
	inhome ip link set br0 up
	for p in 0 1; do
		ip link add "rv-p$p" type veth peer name "home-p$p"
		ip link set "rv-p$p" netns "$RV"
		ip link set "home-p$p" netns "$HOME_NS"
		inhome ip link set "home-p$p" master br0
		inhome ip link set "home-p$p" up
		inrv ip addr add "10.20.1.$((p + 2))/24" dev "rv-p$p"
		inrv ip link set "rv-p$p" up
	done
	# Two addresses in one subnet on one host: answer ARP only on the device
	# that owns the address, or both links would claim both.
	inrv sysctl -qw net.ipv4.conf.all.arp_ignore=1 net.ipv4.conf.all.arp_announce=2 net.ipv4.conf.all.rp_filter=0

	shape 0 "delay 15ms rate 20mbit" "delay 15ms rate 40mbit"
	shape 1 "delay 45ms rate 20mbit" "delay 45ms rate 40mbit"

	for side in rv home; do
		[ -f "$DIR/$side/config.json" ] || echo '{"links":{"rv-p0":{"label":"fast"},"rv-p1":{"label":"slow"}}}' > "$DIR/$side/config.json"
	done

	inhome "$bin" -role responder -tun omp0 -tun-addr 10.30.0.1/24 -tun-mtu 1288 \
		-public "10.20.1.1:$PORT" -state "$DIR/home/state.json" -record "" \
		-config "$DIR/home/config.json" -auth-key "$DIR/none" -wg-interface omp0 -node lab-home \
		>"$DIR/home/ompd.log" 2>&1 &
	echo $! > "$DIR/home/pid"
	inrv "$bin" -role initiator -tun omp0 -tun-addr 10.30.0.2/24 -tun-mtu 1288 \
		-remote "10.20.1.1:$PORT" -paths rv-p0,rv-p1 -state "$DIR/rv/state.json" -record "" -usage "" \
		-linkspeed "$DIR/rv/linkspeed.json" \
		-config "$DIR/rv/config.json" -auth-key "$DIR/none" -wg-interface omp0 -node lab-rv \
		>"$DIR/rv/ompd.log" 2>&1 &
	echo $! > "$DIR/rv/pid"

	for _ in $(seq 1 40); do
		if inrv ping -c1 -W1 10.30.0.1 >/dev/null 2>&1; then
			echo "tunnel up"
			return 0
		fi
		sleep 0.5
	done
	echo "tunnel did not come up; see $DIR/*/ompd.log" >&2
	exit 1
}

down() {
	for side in rv home; do
		[ -f "$DIR/$side/pid" ] && kill "$(cat "$DIR/$side/pid")" 2>/dev/null || true
	done
	ip netns pids "$RV" 2>/dev/null | xargs -r kill 2>/dev/null || true
	ip netns pids "$HOME_NS" 2>/dev/null | xargs -r kill 2>/dev/null || true
	sleep 0.5
	ip netns del "$RV" 2>/dev/null || true
	ip netns del "$HOME_NS" 2>/dev/null || true
	echo "down"
}

mode() {
	for side in rv home; do
		python3 - "$DIR/$side/config.json" "$1" <<'PY'
import json, sys
p, m = sys.argv[1], sys.argv[2]
c = json.load(open(p))
c["bulk_scheduler"] = m
json.dump(c, open(p, "w"))
PY
	done
	sleep 3 # the daemons reload within ~2 s
	echo "bulk_scheduler=$1"
}

iperf() {
	inhome pkill -x iperf3 2>/dev/null || true
	inhome iperf3 -s -B 10.30.0.1 -1 -D
	sleep 0.5
	inrv iperf3 -c 10.30.0.1 -B 10.30.0.2 -J "$@" | python3 -c '
import json, sys
r = json.load(sys.stdin)
if "error" in r: print("iperf error:", r["error"]); sys.exit(1)
e = r["end"]
s = e.get("sum_received") or e.get("sum")
print("received %.1f Mbit/s, retransmits %s" % (s["bits_per_second"] / 1e6, e.get("sum_sent", {}).get("retransmits", "-")))
'
}

rtp() {
	local secs=$1 pcap=$2 dir=${3:-up}
	local send=inrv recv=inhome dst=10.30.0.1 src=10.30.0.2
	if [ "$dir" = down ]; then
		send=inhome recv=inrv dst=10.30.0.2 src=10.30.0.1
	fi
	$recv timeout $((secs + 3)) tcpdump -q -i omp0 -w "$pcap" udp portrange 5004-5006 >/dev/null 2>&1 &
	local cap=$!
	sleep 1
	# Real encoders through real payloaders, as a conferencing client would
	# send: Opus audio at 20 ms and VP8 video fragmented across MTU-sized
	# packets, each its own RTP stream with its own SSRC.
	$send timeout "$secs" gst-launch-1.0 -q \
		audiotestsrc is-live=true wave=sine ! audioconvert ! audioresample ! opusenc bitrate=32000 frame-size=20 ! rtpopuspay ! \
			udpsink host=$dst port=5004 bind-address=$src \
		videotestsrc is-live=true pattern=ball ! video/x-raw,width=640,height=360,framerate=30/1 ! \
			vp8enc deadline=1 target-bitrate=600000 ! rtpvp8pay mtu=1200 ! \
			udpsink host=$dst port=5006 bind-address=$src >/dev/null 2>&1 || true
	wait $cap 2>/dev/null || true
}

state() {
	python3 -m json.tool "$DIR/$1/state.json"
}

cmd=${1:-}
shift || true
case "$cmd" in
up) up "$@" ;;
down) down ;;
mode) mode "$@" ;;
shape) shape "$@" ;;
iperf) iperf "$@" ;;
rtp) rtp "$@" ;;
state) state "$@" ;;
*) sed -n '2,25p' "$0"; exit 2 ;;
esac
