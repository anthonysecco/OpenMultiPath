#!/bin/bash
# Unconditional return to the production shape: the loopback relay below
# WireGuard, on wg0, supervised by systemd. Run by the dead-man timer during
# a D-020 cutover, and safe to run by hand at any time, including when
# nothing is wrong.
#
# Deliberately unconditional, and it ignores every error. This runs on a box
# that may be reachable only over a marginal Wi-Fi link, where a rollback
# that stops at its first failed step is worse than no rollback at all.
# Every step is written to be a no-op when it was not needed.
set +e

# Silence the watchdog first. It probes the tunnel every few seconds, and
# a rollback necessarily takes the tunnel down partway through - without
# this it would enter fallback in the middle of the repair and leave the
# box in a shape nobody asked for.
systemctl stop omp-watchdog.timer 2>/dev/null

# Stop every daemon variant, matched by pattern rather than by a list of
# names known in advance.
#
# The list was the bug. It named ompd and ompd-d020, so an orphaned
# ompd-step9 from a hardware test survived a rollback and went on writing
# the shared state file for a day. The web interface rendered its dead view
# of torn-down interfaces and the live daemon's view alternately, which
# reads exactly like both links flapping between stable and down. ^ompd
# catches any ompd-<experiment> binary the next test leaves behind, and
# does not match ompui, which is supervised separately and wanted up.
#
# Not -f. That would also match this script and the ssh command line that
# invoked it, which is how an operator kills their own session on the box
# they are trying to recover.
pgrep -a '^ompd' 2>/dev/null | sed 's/^/omp-restore: stopping /'
pkill '^ompd'

# D-020's interfaces down, production's back up. The TUN is created by the
# daemon and normally leaves with it; deleting it covers the case where the
# daemon died without cleaning up.
for iface in wgm wg1 wg2; do
	wg-quick down "$iface" 2>/dev/null
done
ip link del omp0 2>/dev/null
wg-quick up wg0 2>/dev/null

# Drop-ins first, and this is the part that is easy to get wrong.
#
# A cutover done with a drop-in leaves the base unit untouched and correct,
# so restoring the base unit looks like it worked and changes nothing at
# all - systemd merges the drop-in back over the top and the D-020 daemon
# comes straight back up against interfaces that have just been taken
# down. The rollback then reports success and the vehicle stays broken,
# which is worse than a rollback that fails loudly.
#
# The watchdog's drop-in has to go with it: it points at the TUN's peer
# address, and left behind it would judge a healthy production tunnel to
# be an outage and fall out of it within half a minute.
rm -f /etc/systemd/system/ompd.service.d/d020.conf
rm -f /etc/systemd/system/omp-watchdog.service.d/d020.conf
rmdir /etc/systemd/system/ompd.service.d 2>/dev/null

# A cutover may also have edited ExecStart in place, so the pristine unit
# is restored regardless. It is kept beside the settings rather than in
# /etc/systemd, where a careless edit would find it.
if [ -f /etc/openmultipath/ompd.service.production ]; then
	install -m 0644 /etc/openmultipath/ompd.service.production \
		/etc/systemd/system/ompd.service
	systemctl daemon-reload
fi

# ompui is supervised separately, and it is the thing that explains what
# happened once the box is back. Forgetting it is how both ends sat with no
# web interface for a day after a rollback that otherwise worked.
systemctl start ompd ompui

# The watchdog is stopped for the duration of a rollback and started again
# at the end, so it cannot see the half-configured box in between and
# decide to fall back on top of a recovery that is already under way.
systemctl restart omp-watchdog.timer 2>/dev/null
