# iperf3 server for the scheduler-pinned uplink diagnostic (D-048).
#
# A twin of omp-iperf.service, not a replacement: that one binds the
# transport hub address 10.20.1.1 and is reached by pinning egress straight
# to a WireGuard interface, which measures the raw link outside ompd
# entirely. This one binds the tunnel's overlay address, 10.30.0.1, so
# traffic aimed at it instead enters through omp0 as an ordinary packet -
# classified and scheduled by the daemon like anything else - which is what
# lets an operator-triggered pin (see internal/diag/diagpin.go) force that
# traffic onto one chosen physical path and measure what ompd's own load
# balancer actually does with it.
#
# Bound explicitly to 10.30.0.1 rather than 0.0.0.0, for the same reason
# omp-iperf.service is not: 10.30.0.1 is the TUN device address, reachable
# only through a tunnel a peer has already authenticated into, whereas
# 0.0.0.0 would also bind whatever address answers on the public interface
# and expose an unauthenticated iperf3 server to the open internet.
#
# If omp0 is not up yet at boot the bind fails and systemd retries until it
# is - the same reasoning as the sibling unit for Restart=always over a hard
# ordering dependency on an interface systemd does not manage.
[Unit]
Description=OpenMultiPath scheduler-pinned uplink diagnostic server (iperf3)
After=network-online.target ompd.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/iperf3 --server --bind 10.30.0.1 --port 5201
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
