#!/bin/bash
# Put the routing around D-020's TUN in place, once the daemon has
# created it.
#
#     omp-tun-up initiator|responder|guard
#
# Run as ExecStartPost on ompd.service, so the routes come back with the
# daemon rather than needing a human after every restart.
#
# The device belongs to the daemon: it is created by `-tun`, addressed by
# `-tun-addr`, and it disappears when the process exits, taking every
# route through it with it. That is why this waits for the device rather
# than assuming it, and why nothing here has to be undone on shutdown.
set +e

ROLE="${1:-}"
TUN="${OMP_TUN:-omp0}"
# Space-separated: the vehicle can have more than one LAN segment, and home
# needs a route back to every one of them.
LAN="${OMP_LAN:-10.0.0.0/24}"
PEER_TUN="${OMP_PEER_TUN:-10.30.0.2}"
# Home's WireGuard transport port (wgm's ListenPort), for the guard below.
WG_PORT="${OMP_WG_PORT:-48219}"

# guard_transports gives every per-link WireGuard transport its unreachable
# rule, so a link that is down takes its tunnel down with it (D-069).
guard_transports() {
	# A link that is down takes its path down with it (D-069).
	#
	# The fwmark pinning (see the initiator case) has a hole. When a link loses carrier, networkd
	# withdraws its table's default route, and a marked packet that finds
	# nothing in its table falls through to main - whose default is the TUN.
	# The transport then rides inside the tunnel over some other link, its
	# probes keep answering, and the daemon reports a dead link as a healthy
	# path: the call's duplicate copy lands on the same link as the original,
	# which is no redundancy at all. WireGuard makes it worse by roaming its
	# peer onto the tunnel address, which can black-hole the link when it
	# comes back.
	#
	# So every transport also gets a rule of its own, just after its lookup:
	# a packet carrying its mark that the lookup did not route is unreachable.
	# That covers the link's table having lost its default route, and the
	# lookup rule itself being gone - networkd deletes a link's rules when
	# the link goes down, and never installs them for a link that is down at
	# boot. A rule rather than an unreachable route in the table, because a
	# route in a table nothing looks up does nothing; that was the first
	# attempt, and it failed the first time a link actually went down.
	#
	# Priority is the table plus 100 (0x2001 is table 2001, guarded at 2101),
	# the convention every transport so far has used. networkd must be told
	# to leave rules it did not write alone (deploy/networkd-omp.conf), and
	# restarted once after that is installed: until then every `networkctl
	# reload` deletes these. `omp-tun-up guard` re-asserts them and nothing
	# else, and ompui runs it after every reload it does.
	for wg in $(wg show interfaces 2>/dev/null); do
		mark=$(wg show "$wg" fwmark 2>/dev/null)
		case "$mark" in
		0x*) ;;
		*) continue ;; # no mark: not a per-link transport
		esac
		table=${mark#0x}
		case "$table" in
		*[!0-9]*)
			echo "omp-tun-up: $wg fwmark $mark does not name a table; not guarding it" >&2
			continue
			;;
		esac
		guard=$((10#$table + 100))
		if ! ip rule show priority "$guard" | grep -q "fwmark $mark.*unreachable"; then
			ip rule add fwmark "$mark" priority "$guard" unreachable
		fi
	done
}

# guard only re-asserts those rules. It needs no TUN, so it runs before
# waiting for one.
if [ "$ROLE" = guard ]; then
	guard_transports
	exit 0
fi

# The daemon opens the device early, but "early" is not "before systemd
# runs the next line". A few seconds of patience here is the difference
# between a working cutover and one that needs somebody to add a route by
# hand from 800 miles away.
for _ in $(seq 1 50); do
	ip link show "$TUN" >/dev/null 2>&1 && break
	sleep 0.2
done
if ! ip link show "$TUN" >/dev/null 2>&1; then
	echo "omp-tun-up: $TUN never appeared; leaving routing alone" >&2
	exit 0
fi

case "$ROLE" in
initiator)
	# The vehicle's default route moves onto the TUN, which is the whole
	# point of the cutover: until this line runs, the daemon is carrying
	# its own probes above WireGuard and nothing else.
	#
	# The transport tunnels cannot loop through it. wg1 and wg2 carry
	# fwmarks matched by ip rules at 2001 and 2002, which send their
	# encrypted packets straight to a per-link table pinned to a physical
	# NIC - evaluated long before the main table's default is reached.
	ip route replace default dev "$TUN" metric 40

	# Carriers hand out host routes for their DNS resolvers so those
	# queries stay on-link, and a /32 beats any default however low its
	# metric. Left alone they are a split tunnel by accident, which
	# D-004 rules out - and DNS is the one leak that also tells the
	# carrier every name the vehicle looks up.
	#
	# This mirrors wg0.conf's PostUp exactly rather than generalising to
	# "every DHCP host route". Some of those are carrier infrastructure
	# reachable only on-link, and pulling them into the tunnel would be a
	# policy change dressed up as a cutover.
	for pin in ${OMP_TUN_PIN:-1.1.1.1 8.8.8.8}; do
		ip route replace "$pin/32" dev "$TUN" metric 40
	done

	guard_transports
	;;
responder)
	# Home has to know where the vehicle's LAN lives now. Without this
	# the inner packets arrive, get written into home's stack, and their
	# replies have nowhere to go.
	for net in $LAN; do
		ip route replace "$net" dev "$TUN"
	done
	ip route replace "$PEER_TUN"/32 dev "$TUN"
	;;
*)
	echo "usage: omp-tun-up initiator|responder|guard" >&2
	exit 2
	;;
esac

# Clamp TCP to the path, the same way the production tunnel does. The
# inner MTU here is smaller than wg0's - the daemon's header rides inside
# WireGuard rather than outside it - so a connection that worked before
# the cutover can black-hole after it without this, and PMTU black holes
# are the single most miserable thing to diagnose from a campground.
if command -v nft >/dev/null 2>&1; then
	nft delete table inet omp-tun 2>/dev/null
	nft add table inet omp-tun 2>/dev/null
	nft add chain inet omp-tun forward \
		'{ type filter hook forward priority mangle ; policy accept ; }' 2>/dev/null
	nft add chain inet omp-tun output \
		'{ type filter hook output priority mangle ; policy accept ; }' 2>/dev/null
	for dir in oifname iifname; do
		nft add rule inet omp-tun forward \
			$dir "\"$TUN\"" tcp flags syn tcp option maxseg size set rt mtu 2>/dev/null
	done
	nft add rule inet omp-tun output \
		oifname "\"$TUN\"" tcp flags syn tcp option maxseg size set rt mtu 2>/dev/null

	# WireGuard transport never goes inside the tunnel, in either direction
	# (D-069). The unreachable routes stop the vehicle's own fall-through;
	# this also stops home answering a transport over the tunnel, which is
	# what lets a peer roam onto a tunnel address in the first place.
	case "$ROLE" in
	initiator) port_match="udp dport $WG_PORT" ;;
	responder) port_match="udp sport $WG_PORT" ;;
	esac
	nft add chain inet omp-tun guard \
		'{ type filter hook output priority filter ; policy accept ; }' 2>/dev/null
	nft add rule inet omp-tun guard oifname "\"$TUN\"" $port_match counter drop 2>/dev/null
fi

echo "omp-tun-up: $ROLE routing in place on $TUN"
